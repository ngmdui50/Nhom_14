QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f7f8fc, stop:0.55 #eef3fb, stop:1 #e7eef8);
    color: #172033;
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
}

QWidget {
    color: #172033;
}

QFrame#frame {
    background: transparent;
    border: none;
}

QFrame#sidebarNavCard, QFrame#sidebarActionCard {
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #dbe7f4;
    border-radius: 24px;
}

QLabel#sidebarSectionTitle {
    color: #5b6f90;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0 8px 8px 8px;
}

QGroupBox {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid #dbe4f0;
    border-radius: 22px;
    margin-top: 16px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 6px 24px;
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #38bdf8);
    border-radius: 14px;
    font-size: 16px;
    font-weight: 800;
}

QGroupBox#groupTrangChu {
    background: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(211, 221, 234, 0.86);
    border-radius: 26px;
}

QLabel {
    font-size: 13px;
    color: #223049;
    background: transparent;
}

QLabel#label {
    color: #0f172a;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: 0.2px;
    padding-left: 6px;
}

QWidget#FormLichKham QLabel#label {
    color: #223049;
    font-size: 13px;
    font-weight: 500;
    padding-left: 0;
    letter-spacing: 0;
}

QWidget#FormBacSi QLabel#label,
QWidget#FormPhong QLabel#label {
    color: #223049;
    font-size: 13px;
    font-weight: 500;
    padding-left: 0;
    letter-spacing: 0;
}

QGroupBox#doctorScheduleBox {
    margin-top: 10px;
    padding-top: 18px;
    border-radius: 18px;
    background: rgba(248, 251, 255, 0.95);
    border: 1px solid #dbe7f4;
}

QGroupBox#doctorScheduleBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 14px;
    margin-left: 10px;
    font-size: 12px;
    font-weight: 700;
    color: #1d4ed8;
    background: #e8f1ff;
    border-radius: 10px;
}

QLabel#doctorScheduleDay {
    font-size: 12px;
    font-weight: 700;
    color: #5b6f90;
    padding-left: 2px;
    min-height: 18px;
}

QWidget#doctorScheduleCell {
    background: transparent;
}

QComboBox#doctorScheduleCombo {
    min-height: 18px;
    padding: 7px 10px;
}

QLabel#lblTime {
    color: #1d4ed8;
    font-size: 14px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid #d6e2f1;
    border-radius: 16px;
    padding: 7px 16px;
}

QWidget#topBarWrap {
    background: rgba(255, 255, 255, 0.58);
    border: 1px solid rgba(214, 226, 241, 0.9);
    border-radius: 20px;
}

QLabel#lblCurrentRole {
    background: #e0ecff;
    color: #1d4ed8;
    border: 1px solid #bfdbfe;
    border-radius: 14px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblTopbarHint {
    background: transparent;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    padding: 0 8px;
}

QPushButton#btnNotification {
    background: #eef5ff;
    color: #1d4ed8;
    border: 1px solid #d6e6ff;
    border-radius: 14px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#lblCurrentUser {
    background: rgba(255, 255, 255, 0.9);
    color: #0f172a;
    border: 1px solid #dbe4f0;
    border-radius: 14px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton {
    background: rgba(245, 248, 253, 0.92);
    color: #3f5574;
    border: 1px solid #edf2f8;
    border-radius: 16px;
    padding: 11px 16px;
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
}

QPushButton:hover {
    background: #eef5ff;
    color: #1d4ed8;
    border: 1px solid #d6e6ff;
}

QPushButton:pressed {
    background: #dbeafe;
    color: #1e40af;
    border: 1px solid #b8d2fb;
}

QPushButton:disabled {
    color: #a8b4c7;
    background: #f3f6fb;
    border: 1px solid #e6edf5;
}

QPushButton#btntrangchu {
    background: rgba(245, 248, 253, 0.92);
    color: #3f5574;
    border: 1px solid #edf2f8;
    font-weight: 700;
}

QPushButton#btntrangchu:hover {
    background: #eef5ff;
    color: #1d4ed8;
    border: 1px solid #d6e6ff;
}

QPushButton[navActive="true"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #38bdf8);
    color: white;
    border: none;
    font-weight: 700;
}

QPushButton[navActive="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:1 #0ea5e9);
    color: white;
    border: none;
}

QPushButton#btnThem {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #60a5fa);
    color: white;
    border: none;
    font-weight: 700;
    text-align: center;
    padding: 8px 12px;
}

QPushButton#btnSua {
    background: rgba(59, 130, 246, 0.1);
    color: #1d4ed8;
    border: 1px solid rgba(147, 197, 253, 0.95);
    text-align: center;
    padding: 8px 12px;
}

QPushButton#btnXoa {
    background: rgba(239, 68, 68, 0.08);
    color: #b91c1c;
    border: 1px solid rgba(252, 165, 165, 0.95);
    text-align: center;
    padding: 8px 12px;
}

QPushButton#btnTimKiem {
    background: rgba(16, 185, 129, 0.08);
    color: #047857;
    border: 1px solid rgba(167, 243, 208, 0.95);
    text-align: center;
    padding: 8px 12px;
}

QPushButton#btnxoaDL {
    background: rgba(100, 116, 139, 0.08);
    color: #475569;
    border: 1px solid rgba(203, 213, 225, 0.95);
    text-align: center;
    padding: 8px 12px;
}

QFrame#toastCard {
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid #bfdbfe;
    border-radius: 16px;
}

QMessageBox {
    background: #151A27;
}

QMessageBox QWidget {
    background: #151A27;
    color: #E2E8F0;
}

QMessageBox QLabel {
    background: transparent;
    color: #E2E8F0;
    font-size: 13px;
    min-width: 240px;
}

QMessageBox QPushButton {
    min-width: 88px;
    text-align: center;
    padding: 8px 14px;
    background: #60a5fa;
    color: #ffffff;
    border: 1px solid #93c5fd;
    border-radius: 12px;
    font-weight: 700;
}

QMessageBox QPushButton:hover {
    background: #3b82f6;
    color: #ffffff;
    border: 1px solid #60a5fa;
}

QMessageBox QPushButton:pressed {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

QMessageBox QPushButton:disabled {
    background: #94a3b8;
    color: #ffffff;
    border: 1px solid #cbd5e1;
}

QInputDialog {
    background: #151A27;
}

QInputDialog QWidget {
    background: #151A27;
    color: #E2E8F0;
}

QInputDialog QLabel {
    background: transparent;
    color: #E2E8F0;
    font-size: 13px;
}

QInputDialog QPlainTextEdit,
QInputDialog QTextEdit,
QInputDialog QLineEdit {
    background: #1E2538;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #60a5fa;
    selection-color: #ffffff;
}

QInputDialog QPushButton {
    min-width: 88px;
    text-align: center;
    padding: 8px 14px;
    background: #60a5fa;
    color: #ffffff;
    border: 1px solid #93c5fd;
    border-radius: 12px;
    font-weight: 700;
}

QInputDialog QPushButton:hover {
    background: #3b82f6;
    color: #ffffff;
    border: 1px solid #60a5fa;
}

QInputDialog QPushButton:pressed {
    background: #2563eb;
    color: #ffffff;
    border: 1px solid #3b82f6;
}

QLabel#toastTitle {
    color: #1d4ed8;
    font-size: 13px;
    font-weight: 800;
}

QLabel#toastMessage {
    color: #334155;
    font-size: 12px;
}

QLineEdit, QComboBox, QDateEdit, QTimeEdit, QSpinBox, QTextEdit {
    background: #f8fbff;
    border: 1px solid #d8e3f0;
    border-radius: 12px;
    padding: 9px 12px;
    color: #122033;
    selection-background-color: #bfdbfe;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QTimeEdit:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1.5px solid #60a5fa;
    background: white;
}

QComboBox::drop-down, QDateEdit::drop-down, QTimeEdit::drop-down {
    border: none;
    width: 24px;
}

QTableWidget {
    background: transparent;
    border: none;
    gridline-color: #edf2f7;
    alternate-background-color: #f8fbff;
    outline: none;
}

QTableWidget::item {
    padding: 10px 8px;
    border-bottom: 1px solid #edf2f7;
}

QTableWidget::item:selected {
    background: #dbeafe;
    color: #1e3a8a;
}

QHeaderView::section {
    background: #f8fbff;
    color: #5c6f8b;
    border: none;
    border-bottom: 1px solid #d8e3f0;
    padding: 11px 8px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

QHeaderView::section:vertical {
    background: #f8fbff;
    color: transparent;
    border: none;
    border-right: 1px solid #edf2f7;
    border-bottom: 1px solid #edf2f7;
}

QTableCornerButton::section {
    background: #f8fbff;
    border: none;
    border-bottom: 1px solid #d8e3f0;
    border-right: 1px solid #edf2f7;
}

QTableWidget QTableButton {
    background: #f8fbff;
}

QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QDialog#notificationDialog {
    background: #f8fbff;
    border: 1px solid #d6e6ff;
    border-radius: 18px;
}

QDialog#notificationDialog QListWidget#notificationList {
    background: #ffffff;
    color: #172033;
    border: 1px solid #dbe7f4;
    border-radius: 14px;
    padding: 8px;
    outline: none;
}

QDialog#notificationDialog QListWidget#notificationList::item {
    background: #f8fbff;
    color: #172033;
    border: 1px solid #e5edf7;
    border-radius: 10px;
    padding: 10px 12px;
    margin: 4px 2px;
}

QDialog#notificationDialog QListWidget#notificationList::item:selected {
    background: #dbeafe;
    color: #1e3a8a;
    border: 1px solid #93c5fd;
}

QMenuBar {
    background: rgba(255, 255, 255, 0.82);
    color: #41546f;
    border-bottom: 1px solid #dbe4f0;
    font-size: 13px;
    font-weight: 600;
}

QMenuBar::item {
    padding: 7px 12px;
    border-radius: 8px;
    margin: 3px 2px;
    background: transparent;
}

QMenuBar::item:selected {
    background: #eef4ff;
    color: #1d4ed8;
}

QMenu {
    background: white;
    color: #223049;
    border: 1px solid #dbe4f0;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: #edf4ff;
    color: #1d4ed8;
}

QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 4px 0;
}

QScrollBar::handle:vertical {
    background: #c8d6e8;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #aebfd8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
}

QFrame#frameThongKe1, QFrame#frameThongKe2, QFrame#frameThongKe3, QFrame#frameThongKe4,
QFrame#frame_2, QFrame#frame_3, QFrame#frame_4, QFrame#frameRevenue, QFrame#frameCompleted, QFrame#frameTotal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #ffffff, stop:1 #f3f8ff);
    border: 1px solid #dbe4f0;
    border-radius: 20px;
}

QLabel#lblRevenueValue, QLabel#lblCompletedValue, QLabel#lblTotalValue,
QLabel#lblTongBN, QLabel#lblTongBS {
    color: #0f172a;
    font-size: 28px;
    font-weight: 800;
}

QFrame#cardLichKham {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
}

QFrame#cardLichKham:hover {
    border: 1px solid #93c5fd;
    background: #f8fbff;
}

QCalendarWidget QWidget {
    background: white;
    alternate-background-color: #f8fbff;
}

QCalendarWidget QToolButton {
    color: #1d4ed8;
    background: #f8fbff;
    border: 1px solid #dbe4f0;
    border-radius: 10px;
    font-weight: 700;
    padding: 6px 10px;
}

QCalendarWidget QMenu {
    width: 140px;
    left: 20px;
}

QCalendarWidget QSpinBox {
    background: white;
    border: 1px solid #dbe4f0;
    border-radius: 8px;
    padding: 4px 8px;
    color: #0f172a;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #1e293b;
    background: white;
    border: 1px solid #dbe4f0;
    border-radius: 12px;
    selection-background-color: #bfdbfe;
    selection-color: #1e3a8a;
}

QCalendarWidget QAbstractItemView:enabled:hover {
    background: #f8fbff;
}
